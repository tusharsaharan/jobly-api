# Sample environment for jobly-api (copy to .env and fill in)
# Single-machine demo: services run in docker-compose, API+web run on host.

NODE_ENV=development
PORT=5000

# MongoDB (compose publishes on localhost:27017)
MONGO_URI=mongodb://127.0.0.1:27017/jobmatch?directConnection=true

# Security - generate with: openssl rand -base64 48
JWT_SECRET=replace_with_random_64_char_secret
JWT_REFRESH_SECRET=replace_with_another_random_64_char_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider (Gemini). Empty disables AI features gracefully.
GEMINI_API_KEY=

# Redis (compose publishes on localhost:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# S3 / MinIO (compose publishes on localhost:9000)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=jobly-resumes
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# LiveKit (compose runs --dev with devkey: secret)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Terminal runner (compose publishes on localhost:4100)
TERMINAL_RUNNER_URL=http://127.0.0.1:4100

# CORS / Frontend origin (vite dev server)
CLIENT_ORIGIN=http://localhost:8080
